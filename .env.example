# Root-level reference for env vars shared across the monorepo. Each app
# also keeps its own .env.example (apps/api, apps/web, packages/db) with
# the exact set it reads — copy those into place for local development,
# e.g. via `docker-compose up -d` for Postgres/Redis/Meilisearch.

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/songverse_dev?schema=public"
REDIS_URL="redis://localhost:6379"
MEILISEARCH_HOST="http://localhost:7700"
MEILISEARCH_API_KEY="dev-master-key"

AUTH_URL="http://localhost:3000"
BETTER_AUTH_SECRET=""

VITE_API_URL="http://localhost:3001"

R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="songverse"
R2_ENDPOINT=""
