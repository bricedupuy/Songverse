# Shared with packages/db — same Postgres instance.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/songverse_dev?schema=public"

AUTH_URL="http://localhost:3000"
BETTER_AUTH_SECRET="replace-with: npx -y @better-auth/cli secret"

# Comma-separated emails auto-promoted to global admin on sign-up. There's
# no admin UI yet, so this is the only way in.
BOOTSTRAP_ADMIN_EMAILS="you@example.com"

# The NestJS API's public URL. A normal runtime env var — see
# src/lib/public-env.ts for why it's not done via Vite's build-time
# VITE_-prefixed env inlining.
API_URL="http://localhost:3001"

# Resend (https://resend.com) - sends the account-verification and
# password-reset emails (see src/lib/email.ts). Leave RESEND_API_KEY unset
# for local dev: emails are logged to the console instead of sent, so sign-up
# still works without a Resend account. In production, only these two
# transactional emails are ever sent - no marketing/bulk mail - to stay
# comfortably inside the free tier's daily/monthly send cap.
RESEND_API_KEY=""
EMAIL_FROM="SongVerse <onboarding@resend.dev>"

# Google sign-in (optional). Leave both unset to disable it entirely - the
# "Continue with Google" button only appears once both are set. Create an
# OAuth client at https://console.cloud.google.com/apis/credentials with
# authorized redirect URI "<AUTH_URL>/api/auth/callback/google".
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
