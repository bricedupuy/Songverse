# Shared with packages/db — same Postgres instance.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/songverse_dev?schema=public"

AUTH_URL="http://localhost:3000"
BETTER_AUTH_SECRET="replace-with: npx -y @better-auth/cli secret"

# Comma-separated emails auto-promoted to global admin on sign-up. There's
# no admin UI yet, so this is the only way in.
BOOTSTRAP_ADMIN_EMAILS="you@example.com"

# The NestJS API's public URL. A normal runtime env var — see
# src/lib/public-env.ts for why it's not done via Vite's build-time
# VITE_-prefixed env inlining.
API_URL="http://localhost:3001"
