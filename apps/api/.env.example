PORT=3001

# Shared with packages/db — same Postgres instance.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/songverse_dev?schema=public"

# BetterAuth issuer (apps/web). JwtAuthGuard verifies tokens against
# ${AUTH_URL}/api/auth/jwks.
AUTH_URL="http://localhost:3000"

REDIS_URL="redis://localhost:6379"

# Meilisearch (wired up in Phase 6)
MEILISEARCH_HOST="http://localhost:7700"
MEILISEARCH_API_KEY=""

# Cloudflare R2 (S3-compatible)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="songverse"
R2_ENDPOINT=""
