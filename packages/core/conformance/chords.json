    "formatChord": {
      "about": "A chord named in letters (\"english\", as written) or solfège (\"solfege\": Do, Ré, Mi…).",
      "params": [
        "raw",
        "notation"
      ],
      "cases": [
        {
          "name": "G in solfège",
          "args": [
            "G",
            "solfege"
          ],
          "expected": "Sol"
        },
        {
          "name": "G in letters",
          "args": [
            "G",
            "english"
          ],
          "expected": "G"
        },
        {
          "name": "Em7 in solfège",
          "args": [
            "Em7",
            "solfege"
          ],
          "expected": "Mim7"
        },
        {
          "name": "Em7 in letters",
          "args": [
            "Em7",
            "english"
          ],
          "expected": "Em7"
        },
        {
          "name": "D/F# in solfège",
          "args": [
            "D/F#",
            "solfege"
          ],
          "expected": "Ré/Fa#"
        },
        {
          "name": "D/F# in letters",
          "args": [
            "D/F#",
            "english"
          ],
          "expected": "D/F#"
        },
        {
          "name": "Bbmaj7 in solfège",
          "args": [
            "Bbmaj7",
            "solfege"
          ],
          "expected": "Sibmaj7"
        },
        {
          "name": "Bbmaj7 in letters",
          "args": [
            "Bbmaj7",
            "english"
          ],
          "expected": "Bbmaj7"
        },
        {
          "name": "C#m in solfège",
          "args": [
            "C#m",
            "solfege"
          ],
          "expected": "Do#m"
        },
        {
          "name": "C#m in letters",
          "args": [
            "C#m",
            "english"
          ],
          "expected": "C#m"
        },
        {
          "name": "N.C. in solfège",
          "args": [
            "N.C.",
            "solfege"
          ],
          "expected": "N.C."
        },
        {
          "name": "N.C. in letters",
          "args": [
            "N.C.",
            "english"
          ],
          "expected": "N.C."
        }
      ]
    },
    "simplifyChord": {
      "about": "A chord made easier: only its triad (dropExtensions), without its bass note (dropBass).",
      "params": [
        "raw",
        "options"
      ],
      "cases": [
        {
          "name": "Gmaj7 {\"dropExtensions\":true}",
          "args": [
            "Gmaj7",
            {
              "dropExtensions": true
            }
          ],
          "expected": "G"
        },
        {
          "name": "Em7 {\"dropExtensions\":true}",
          "args": [
            "Em7",
            {
              "dropExtensions": true
            }
          ],
          "expected": "Em"
        },
        {
          "name": "Bm7b5 {\"dropExtensions\":true}",
          "args": [
            "Bm7b5",
            {
              "dropExtensions": true
            }
          ],
          "expected": "Bdim"
        },
        {
          "name": "Csus4 {\"dropExtensions\":true}",
          "args": [
            "Csus4",
            {
              "dropExtensions": true
            }
          ],
          "expected": "Csus4"
        },
        {
          "name": "Cadd9 {\"dropExtensions\":true}",
          "args": [
            "Cadd9",
            {
              "dropExtensions": true
            }
          ],
          "expected": "C"
        },
        {
          "name": "D/F# {\"dropBass\":true}",
          "args": [
            "D/F#",
            {
              "dropBass": true
            }
          ],
          "expected": "D"
        },
        {
          "name": "Am7/G {\"dropExtensions\":true,\"dropBass\":true}",
          "args": [
            "Am7/G",
            {
              "dropExtensions": true,
              "dropBass": true
            }
          ],
          "expected": "Am"
        },
        {
          "name": "G {}",
          "args": [
            "G",
            {}
          ],
          "expected": "G"
        }
      ]
    },
    "sameChord": {
      "about": "Whether two symbols are the same chord, however written.",
