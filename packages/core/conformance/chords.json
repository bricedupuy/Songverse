    "transposeChord": {
      "about": "A chord moved by semitones, spelt with sharps or flats as the target key uses; anything that isn't a chord is left as written.",
      "params": [
        "raw",
        "steps",
        "targetKey"
      ],
      "cases": [
        {
          "name": "G by 2 to A",
          "args": [
            "G",
            2,
            "A"
          ],
          "expected": "A"
        },
        {
          "name": "D/F# by 2 to A",
          "args": [
            "D/F#",
            2,
            "A"
          ],
          "expected": "E/G#"
        },
        {
          "name": "Em7 by 1 to F",
          "args": [
            "Em7",
            1,
            "F"
          ],
          "expected": "Fm7"
        },
        {
          "name": "Bb by 1 to null",
          "args": [
            "Bb",
            1,
            null
          ],
          "expected": "B"
        },
        {
          "name": "C by -1 to B",
          "args": [
            "C",
            -1,
            "B"
          ],
          "expected": "B"
        },
        {
          "name": "C by 1 to Db",
          "args": [
            "C",
            1,
            "Db"
          ],
          "expected": "Db"
        },
        {
          "name": "F#m7b5 by -2 to E",
          "args": [
            "F#m7b5",
            -2,
            "E"
          ],
          "expected": "Em7b5"
        },
        {
          "name": "N.C. by 3 to C",
          "args": [
            "N.C.",
            3,
            "C"
          ],
          "expected": "N.C."
        },
        {
          "name": "(Am) by 5 to D",
          "args": [
            "(Am)",
            5,
            "D"
          ],
          "expected": "(Dm)"
        },
        {
          "name": "verse by 2 to A",
          "args": [
            "verse",
            2,
            "A"
          ],
          "expected": "verse"
        },
        {
          "name": "G by 0 to G",
          "args": [
            "G",
            0,
            "G"
          ],
          "expected": "G"
        },
        {
          "name": "G by 12 to G",
          "args": [
            "G",
            12,
            "G"
          ],
          "expected": "G"
        }
      ]
    },
