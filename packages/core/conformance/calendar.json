{
  "$schema": "songverse-conformance/v1",
  "area": "calendar",
  "about": "A team's calendar (issue #235): the dates an event falls on, at its wall-clock time in the team's time zone - the same across daylight saving.",
  "functions": {
    "eventDates": {
      "about": "The dates from `from` to `to` (included), with each date's own changes.",
      "params": [
        "event",
        "from",
        "to",
        "changes"
      ],
      "cases": [
        {
          "name": "a one-off",
          "args": [
            {
              "date": "2026-12-24",
              "startTime": "18:00",
              "durationMinutes": 90,
              "timeZone": "Europe/Paris"
            },
            "2026-12-01",
            "2026-12-31",
            []
          ],
          "expected": [
            {
              "date": "2026-12-24",
              "startTime": "18:00",
              "startsAt": "2026-12-24T17:00:00.000Z",
              "endsAt": "2026-12-24T18:30:00.000Z",
              "title": null,
              "cancelled": false,
              "changed": false
            }
          ]
        },
        {
          "name": "a one-off outside the range",
          "args": [
            {
              "date": "2026-12-24",
              "startTime": "18:00",
              "durationMinutes": 90,
              "timeZone": "Europe/Paris"
            },
            "2027-01-01",
            "2027-01-31",
            []
          ],
          "expected": []
        },
        {
          "name": "every Sunday at 10:00 across the clocks going back",
          "args": [
            {
              "date": "2026-10-11",
              "startTime": "10:00",
              "durationMinutes": 120,
              "timeZone": "Europe/Paris",
              "repeat": {
                "everyWeeks": 1
              }
            },
            "2026-10-12",
            "2026-11-08",
            []
          ],
          "expected": [
            {
              "date": "2026-10-18",
              "startTime": "10:00",
              "startsAt": "2026-10-18T08:00:00.000Z",
              "endsAt": "2026-10-18T10:00:00.000Z",
              "title": null,
              "cancelled": false,
              "changed": false
            },
            {
              "date": "2026-10-25",
              "startTime": "10:00",
              "startsAt": "2026-10-25T09:00:00.000Z",
              "endsAt": "2026-10-25T11:00:00.000Z",
              "title": null,
              "cancelled": false,
              "changed": false
            },
            {
              "date": "2026-11-01",
              "startTime": "10:00",
              "startsAt": "2026-11-01T09:00:00.000Z",
              "endsAt": "2026-11-01T11:00:00.000Z",
              "title": null,
              "cancelled": false,
              "changed": false
            },
            {
              "date": "2026-11-08",
              "startTime": "10:00",
              "startsAt": "2026-11-08T09:00:00.000Z",
              "endsAt": "2026-11-08T11:00:00.000Z",
              "title": null,
              "cancelled": false,
              "changed": false
            }
          ]
        },
        {
          "name": "every other week, until a date, one cancelled and one moved",
          "args": [
            {
              "date": "2026-01-04",
              "startTime": "09:30",
              "durationMinutes": 90,
              "timeZone": "America/New_York",
              "repeat": {
                "everyWeeks": 2,
                "until": "2026-03-29"
              }
            },
            "2026-02-01",
            "2026-12-31",
            [
              {
                "date": "2026-02-15",
                "cancelled": true
              },
              {
                "date": "2026-03-15",
                "startTime": "11:00",
                "title": "Easter rehearsal"
              }
            ]
          ],
          "expected": [
            {
              "date": "2026-02-01",
              "startTime": "09:30",
              "startsAt": "2026-02-01T14:30:00.000Z",
              "endsAt": "2026-02-01T16:00:00.000Z",
              "title": null,
              "cancelled": false,
              "changed": false
            },
            {
              "date": "2026-02-15",
              "startTime": "09:30",
              "startsAt": "2026-02-15T14:30:00.000Z",
              "endsAt": "2026-02-15T16:00:00.000Z",
              "title": null,
              "cancelled": true,
              "changed": false
            },
            {
              "date": "2026-03-01",
              "startTime": "09:30",
              "startsAt": "2026-03-01T14:30:00.000Z",
              "endsAt": "2026-03-01T16:00:00.000Z",
              "title": null,
              "cancelled": false,
              "changed": false
            },
            {
              "date": "2026-03-15",
              "startTime": "11:00",
              "startsAt": "2026-03-15T15:00:00.000Z",
              "endsAt": "2026-03-15T16:30:00.000Z",
              "title": "Easter rehearsal",
              "cancelled": false,
              "changed": true
            },
            {
              "date": "2026-03-29",
              "startTime": "09:30",
              "startsAt": "2026-03-29T13:30:00.000Z",
              "endsAt": "2026-03-29T15:00:00.000Z",
              "title": null,
              "cancelled": false,
              "changed": false
            }
          ]
        },
        {
          "name": "a range before the first date",
          "args": [
            {
              "date": "2026-10-11",
              "startTime": "10:00",
              "durationMinutes": 60,
              "timeZone": "UTC",
              "repeat": {
                "everyWeeks": 1
              }
            },
            "2026-09-01",
            "2026-10-20",
            []
          ],
          "expected": [
            {
              "date": "2026-10-11",
              "startTime": "10:00",
              "startsAt": "2026-10-11T10:00:00.000Z",
              "endsAt": "2026-10-11T11:00:00.000Z",
              "title": null,
              "cancelled": false,
              "changed": false
            },
            {
              "date": "2026-10-18",
              "startTime": "10:00",
              "startsAt": "2026-10-18T10:00:00.000Z",
              "endsAt": "2026-10-18T11:00:00.000Z",
              "title": null,
              "cancelled": false,
              "changed": false
            }
          ]
        }
      ]
    },
    "zonedInstant": {
      "about": "The instant a wall-clock time happens in a time zone; a time skipped by the clocks going forward is taken an hour later, one that happens twice as the first.",
      "params": [
        "date",
        "time",
        "timeZone"
      ],
      "cases": [
        {
          "name": "summer in Paris",
          "args": [
            "2026-07-05",
            "10:00",
            "Europe/Paris"
          ],
          "expected": "2026-07-05T08:00:00.000Z"
        },
        {
          "name": "winter in Paris",
          "args": [
            "2026-12-06",
            "10:00",
            "Europe/Paris"
          ],
          "expected": "2026-12-06T09:00:00.000Z"
        },
        {
          "name": "skipped: 02:30 the day the clocks go forward",
          "args": [
            "2026-03-29",
            "02:30",
            "Europe/Paris"
          ],
          "expected": "2026-03-29T01:30:00.000Z"
        },
        {
          "name": "twice: 02:30 the day the clocks go back",
          "args": [
            "2026-10-25",
            "02:30",
            "Europe/Paris"
          ],
          "expected": "2026-10-25T00:30:00.000Z"
        },
        {
          "name": "Sydney",
          "args": [
            "2026-04-05",
            "10:00",
            "Australia/Sydney"
          ],
          "expected": "2026-04-05T00:00:00.000Z"
        }
      ]
    },
    "localDate": {
      "about": "The date an instant falls on in a time zone.",
      "params": [
        "instant",
        "timeZone"
      ],
      "cases": [
        {
          "name": "late evening in New York is the next day in UTC",
          "args": [
            "2026-10-12T02:00:00.000Z",
            "America/New_York"
          ],
          "expected": "2026-10-11"
        },
        {
          "name": "Tokyo",
          "args": [
            "2026-10-11T20:00:00.000Z",
            "Asia/Tokyo"
          ],
          "expected": "2026-10-12"
        }
      ]
    },
    "effectiveAnswer": {
      "about": "Someone's answer for a date: their own if they gave one, else Not available on a day they're away, else none (never taken as Available).",
      "params": [
        "own",
        "away",
        "date"
      ],
      "cases": [
        {
          "name": "answered",
          "args": [
            "IF_NEEDED",
            [],
            "2026-08-09"
          ],
          "expected": {
            "answer": "IF_NEEDED",
            "away": false
          }
        },
        {
          "name": "away that day",
          "args": [
            null,
            [
              {
                "from": "2026-08-01",
                "to": "2026-08-15"
              }
            ],
            "2026-08-09"
          ],
          "expected": {
            "answer": "UNAVAILABLE",
            "away": true
          }
        },
        {
          "name": "away, but answered for that day",
          "args": [
            "AVAILABLE",
            [
              {
                "from": "2026-08-01",
                "to": "2026-08-15"
              }
            ],
            "2026-08-09"
          ],
          "expected": {
            "answer": "AVAILABLE",
            "away": false
          }
        },
        {
          "name": "away on the last day of the range",
          "args": [
            null,
            [
              {
                "from": "2026-08-01",
                "to": "2026-08-15"
              }
            ],
            "2026-08-15"
          ],
          "expected": {
            "answer": "UNAVAILABLE",
            "away": true
          }
        },
        {
          "name": "no answer",
          "args": [
            null,
            [
              {
                "from": "2026-08-01",
                "to": "2026-08-15"
              }
            ],
            "2026-08-16"
          ],
          "expected": {
            "answer": null,
            "away": false
          }
        }
      ]
    },
    "setListing": {
      "about": "Where a set is listed for someone: a set made by hand as always; an event's set in the sidebar while coming if they signed up, on the Sets page only if not; once past, in the archive if they took part, else hidden.",
      "params": [
        "set"
      ],
      "cases": [
        {
          "name": "made by hand",
          "args": [
            {
              "fromEvent": false
            }
          ],
          "expected": "sidebar"
        },
        {
          "name": "coming, signed up",
          "args": [
            {
              "fromEvent": true,
              "signedUp": true,
              "past": false
            }
          ],
          "expected": "sidebar"
        },
        {
          "name": "coming, not signed up",
          "args": [
            {
              "fromEvent": true,
              "signedUp": false,
              "past": false
            }
          ],
          "expected": "list"
        },
        {
          "name": "past, took part",
          "args": [
            {
              "fromEvent": true,
              "signedUp": true,
              "past": true
            }
          ],
          "expected": "archive"
        },
        {
          "name": "past, didn't take part",
          "args": [
            {
              "fromEvent": true,
              "signedUp": false,
              "past": true
            }
          ],
          "expected": "hidden"
        }
      ]
    },
    "isPastDate": {
      "about": "Whether a date is over: before today in the team's time zone. An event's date is still coming on the day.",
      "params": [
        "date",
        "now",
        "timeZone"
      ],
      "cases": [
        {
          "name": "the same day, in the evening",
          "args": [
            "2026-10-11",
            "2026-10-11T21:00:00.000Z",
            "Europe/Paris"
          ],
          "expected": false
        },
        {
          "name": "the day after",
          "args": [
            "2026-10-11",
            "2026-10-11T23:30:00.000Z",
            "Europe/Paris"
          ],
          "expected": true
        }
      ]
    }
  }
}
