      ],
      "cases": [
        {
          "name": "as shown",
          "args": [
            "K7Q-M3X"
          ],
          "expected": "K7QM3X"
        },
        {
          "name": "typed in lower case with a space",
          "args": [
            "k7q m3x"
          ],
          "expected": "K7QM3X"
        },
        {
          "name": "a letter it never uses (O)",
          "args": [
            "K7Q-O3X"
          ],
          "expected": null
