    "resolveScreenTheme": {
      "about": "A screen theme as every client reads it (issue #194, docs/screen-theme-v1.md): what it says over the defaults; a part it can't read falls back to that part's defaults, a field it doesn't know is ignored, and anything that isn't a theme is the default look.",
      "params": [
        "input"
      ],
      "cases": [
        {
          "name": "nothing: the default look",
          "args": [
            {}
          ],
          "expected": {
            "$schema": "screen-theme/v1",
            "text": {
              "font": "sans",
              "size": "auto",
              "weight": 600,
              "upperCase": false,
              "color": "#ffffff",
              "effect": "shadow",
              "lineHeight": 1.15,
              "align": "center",
              "letterSpacing": 0
            },
            "lines": {
              "group": "slide",
              "before": 1,
              "after": 1,
              "contextStyle": "dim"
            },
            "layout": {
              "position": "center",
              "margin": 5
            },
            "background": {
              "kind": "color",
              "colors": [
                "#000000"
              ],
              "reactive": false,
              "motion": 0.5,
              "dim": 0
            },
            "title": {
              "show": true,
              "when": "first"
            },
